/* =====================================================
   SAVE BOOKING
===================================================== */

document
  .getElementById("saveBooking")
  .addEventListener(
    "click",
    saveBooking
  );


function saveBooking(){

  const bookingId =
    document
      .getElementById("bookingId")
      .innerText;

  const guestName =
    document
      .getElementById("guestName")
      .value
      .trim();

  const phone =
    document
      .getElementById("guestPhone")
      .value
      .trim();

  const email =
    document
      .getElementById("guestEmail")
      .value
      .trim();

  const address =
    document
      .getElementById("guestAddress")
      .value
      .trim();

  const room =
    document
      .getElementById("bookingRoom")
      .value;

  const checkIn =
    document
      .getElementById("checkIn")
      .value;

  const checkOut =
    document
      .getElementById("checkOut")
      .value;

  const numberGuests =
    document
      .getElementById("numberGuests")
      .value;

  const idProofType =
    document
      .getElementById("idProofType")
      .value;

  const idProofNumber =
    document
      .getElementById("idProofNumber")
      .value
      .trim();

  const amount =
    document
      .getElementById("bookingAmount")
      .value;

  const paymentStatus =
    document
      .getElementById("paymentStatus")
      .value;

  const paymentMethod =
    document
      .getElementById("paymentMethod")
      .value;

  const specialRequests =
    document
      .getElementById("specialRequests")
      .value
      .trim();


  /* Validation */

  if(
    !guestName ||
    !phone ||
    !room ||
    !checkIn ||
    !checkOut ||
    !amount
  ){

    alert(
      "Please fill all required fields."
    );

    return;

  }


  if(
    new Date(checkOut)
    <=
    new Date(checkIn)
  ){

    alert(
      "Check-out date must be after check-in date."
    );

    return;

  }


  /* Create booking */

  const booking = {

    id:bookingId,

    guest:guestName,

    phone:phone,

    email:email,

    address:address,

    room:room,

    checkIn:checkIn,

    checkOut:checkOut,

    guests:Number(numberGuests),

    idProofType:idProofType,

    idProofNumber:idProofNumber,

    amount:Number(amount),

    paymentStatus:paymentStatus,

    paymentMethod:paymentMethod,

    specialRequests:specialRequests,

    status:
      paymentStatus === "Paid"
        ? "Confirmed"
        : "Pending"

  };


  bookings.push(booking);


  localStorage.setItem(
    "hotelBookings",
    JSON.stringify(bookings)
  );


  /* Mark room occupied */

  const selectedRoom =
    rooms.find(
      r =>
        r.number === room
    );


  if(selectedRoom){

    selectedRoom.status =
      "Occupied";

    saveRooms();

  }


  alert(
    "Booking saved successfully!"
  );


  clearBookingForm();

  showDashboard();

}


/* =====================================================
   RENDER BOOKINGS
===================================================== */

function renderBookings(){

  const table =
    document.getElementById(
      "booking-table"
    );

  table.innerHTML = "";


  if(bookings.length === 0){

    table.innerHTML = `

      <tr>

        <td
          colspan="7"
          style="
            text-align:center;
            color:var(--muted);
          "
        >
          No bookings available.
        </td>

      </tr>

    `;

    return;

  }


  bookings.forEach(
    booking => {

      const row =
        document.createElement("tr");


      row.innerHTML = `

        <td>
          <strong>
            ${escapeHTML(booking.id)}
          </strong>
        </td>

        <td>
          ${escapeHTML(booking.guest)}
        </td>

        <td>
          ${escapeHTML(booking.room)}
        </td>

        <td>
          ${formatDate(booking.checkIn)}
        </td>

        <td>
          ${formatDate(booking.checkOut)}
        </td>

        <td>
          ₹${Number(
            booking.amount
          ).toLocaleString("en-IN")}
        </td>

        <td>

          <span class="pill ${
            booking.status === "Confirmed"
              ? "available"
              : "occupied"
          }">

            ${escapeHTML(
              booking.status
            )}

          </span>

        </td>

      `;


      table.appendChild(row);

    }
  );

}


/* =====================================================
   KPI
===================================================== */

function updateKPI(){

  const roomsCount =
    rooms.length;

  const occupied =
    rooms.filter(
      room =>
        room.status === "Occupied"
    ).length;


  const todayString =
    new Date()
      .toISOString()
      .split("T")[0];


  const revenue =
    bookings
      .filter(
        booking =>
          booking.checkIn ===
          todayString
      )
      .reduce(
        (sum, booking) =>
          sum +
          Number(
            booking.amount
          ),
        0
      );


  document
    .getElementById("roomsKPI")
    .innerText =
      roomsCount;


  document
    .getElementById("occupiedKPI")
    .innerText =
      occupied;


  document
    .getElementById("revenueKPI")
    .innerText =
      "₹" +
      revenue.toLocaleString(
        "en-IN"
      );

}


/* =====================================================
   SEARCH
===================================================== */

document
  .getElementById("searchInput")
  .addEventListener(
    "input",
    function(){

      const filter =
        this.value
          .toLowerCase()
          .trim();


      const rows =
        document.querySelectorAll(
          "#booking-table tr"
        );


      rows.forEach(
        row => {

          const text =
