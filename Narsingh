/* =====================================================
   HELPERS
===================================================== */

function formatDate(date){

  if(!date){
    return "-";
  }

  return new Date(date)
    .toLocaleDateString(
      "en-IN",
      {
        day:"2-digit",
        month:"short",
        year:"numeric"
      }
    );

}


/* Prevent HTML injection */

function escapeHTML(value){

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


